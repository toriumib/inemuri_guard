<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 画面を消しても・他のアプリを開いても見張りを続けるために要る。
         Android 14 以降はサービスの「型」ごとに権限が分かれていて、
         カメラを使い続けるなら FOREGROUND_SERVICE_CAMERA が必須。
         これが無いと起動時に例外で落ちる。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- 予約した通知（ポモドーロの終了・水分補給）を再起動後に張り直すため。
         SCHEDULE_EXACT_ALARM は入れない。数分の遅れを許す inexact で足りるし、
         Play のポリシー上も慎重に扱われる権限なので。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 画面ロック中に鳴ったら、通知ではなくこのアプリの画面（大きな「起きた！」）を出す。
         Android 14 以降はアラーム／通話以外は設定での許可が要る。居眠りアラームは該当。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- 車に乗ったら始める：車の Bluetooth の接続を見る。12 以降は実行時許可、
         それより前は BLUETOOTH だけでよい。位置情報は使わない。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- 運転を体で検知して始める（設定で ON にしたときだけ登録）。10 以降は実行時許可。 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"/>
    <!-- 制限速度の知らせ（車モード・画面を開いている間だけ。背面の位置は取らない） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-feature android:name="android.hardware.camera" android:required="true"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- NFC タグ（URI: inemuri://start）を読んだとき、タグをホルダーに貼って
                 置くだけで開く。Tasker などの自動化アプリからも同じ URI で開ける。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="inemuri" android:host="start"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="inemuri" android:host="start"/>
            </intent-filter>
            <!-- 自動化アプリ向けの起動 Intent（com.stop.sleeping.START）。 -->
            <intent-filter>
                <action android:name="com.stop.sleeping.START"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- 見張りを続けるための常駐サービス。
             型に camera と microphone を両方書いているのは、瞼検知(カメラ)と
             寝息検知(マイク)のどちらを使っていても止まらないようにするため。
             ⚠️ Android 14 以降、camera 型のサービスは「アプリが画面に出ている間」
             にしか開始できない。開始は必ずユーザーが「検知を開始」を押した
             その場で行うこと。バックグラウンドから起こそうとすると失敗する。 -->
        <!-- 自前の見張りサービス。Camera2 を Service 側で開くことで、
             Activity のライフサイクルから外れて背面でも動き続ける。 -->
        <service
            android:name=".EyeService"
            android:foregroundServiceType="camera|microphone"
            android:exported="false"
            android:stopWithTask="true"/>

        <!-- 車に乗った／降りた。Bluetooth の接続・切断はアプリが死んでいても届く。 -->
        <receiver
            android:name=".CarTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED"/>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED"/>
                <action android:name="com.stop.sleeping.TEST_BOARD"/>
                <action android:name="com.stop.sleeping.TEST_LEFT"/>
            </intent-filter>
        </receiver>

        <!-- クイック設定の「居眠りガード」タイル。1 回押すと開いて見張りが始まる。 -->
        <service
            android:name=".WatchTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- Slack/Teams/メールの通知で起こすための受け口。
             通知アクセスはユーザーが設定画面で明示的に許可しないと有効に
             ならない。中身は読むだけで、送信も保存もしない。 -->
        <service
            android:name=".NudgeListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- 予約通知（ポモドーロの終了・水分補給）の受け口。
             ⚠️ flutter_local_notifications は v17 以降、この2つをアプリ側で
             宣言しないと**予約が OS に入るのに通知が一度も出ない**。
             実機で 19:55 と 20:11 の予約が消えただけで何も鳴らず、マージ後の
             マニフェストに receiver が無いことで発覚した。
             Boot 側は再起動・アプリ更新後に予約を張り直すためのもの。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <!-- 通知の「止める」ボタン。アプリを開かずに背面の isolate で受ける。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- AdMob アプリ ID。本番の値は android/admob.properties（git 管理外）から
             build.gradle.kts が差し込む。無ければ Google の公開サンプル ID。 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 車で使うとき、地図アプリ（geo:）とブラウザ（https）を開く。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
